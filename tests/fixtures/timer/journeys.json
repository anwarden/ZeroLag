{
  "base_url": "http://127.0.0.1:PORT",
  "journeys": [
    {"id": "tabs", "name": "Load table", "start": "/tabs.html", "start_ready": "#load", "action": {"click": "#load"}, "ready": {"selector": "#result"}},
    {"id": "busy", "name": "Busy handler", "start": "/busy.html", "action": {"click": "#busy"}, "ready": {"selector": "#done"}},
    {"id": "nav", "name": "Hard navigation", "start": "/nav.html", "action": {"click": "#go"}, "ready": {"selector": "#arrived", "url": "target.html"}},
    {"id": "goto", "name": "Direct load", "start": "/nav.html", "action": {"goto": "/target.html"}, "ready": {"selector": "#arrived"}},
    {"id": "already", "name": "Bad ready condition", "start": "/already.html", "action": {"click": "#load"}, "ready": {"selector": "#result"}}
  ]
}
